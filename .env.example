# Copie para .env (que é ignorado pelo git) e preencha.
# O daemon lê este arquivo pelo systemd (EnvironmentFile) ou pelo ambiente do shell.

# Token do bot, do @BotFather. Nunca vai para o config.toml nem para o git.
LUKADISPATCH_TELEGRAM_TOKEN=

# Id do supergrupo com tópicos ligados. Começa com -100.
# Também pode ficar em ~/.config/lukadispatch/config.toml, em [telegram] chat_id.
LUKADISPATCH_CHAT_ID=

# Opcional: nível de log do daemon (error, warn, info, debug, trace).
# RUST_LOG=info

# Opcional: caminho do socket de controle. Só para teste; o padrão é
# $XDG_RUNTIME_DIR/lukadispatch.sock.
# LUKADISPATCH_SOCKET=
